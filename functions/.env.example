# 네이버 클라우드 SENS (Simple & Easy Notification Service) 설정
# https://console.ncloud.com/sens/sms

# SENS 서비스 ID (프로젝트에서 생성한 서비스 ID)
NAVER_SENS_SERVICE_ID=ncp:sms:kr:xxxxxxxxxxxxx:your-service-name

# 네이버 클라우드 플랫폼 인증키 (API Gateway 인증키)
# https://console.ncloud.com/mc/solution/naverService/application
NAVER_SENS_ACCESS_KEY=your-access-key-here
NAVER_SENS_SECRET_KEY=your-secret-key-here

# 발신번호 (SENS에서 등록 및 승인받은 전화번호)
NAVER_SENS_CALLING_NUMBER=01012345678
