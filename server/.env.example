# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret Key (Change this in production!)
JWT_SECRET=your-secret-key-here

# PostgreSQL Database Configuration
DB_USER=returnmecup
DB_HOST=localhost
DB_NAME=returnmecup_db
DB_PASSWORD=your-db-password-here
DB_PORT=5432

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# BizM Alimtalk Configuration
BIZM_USER_ID=your-bizm-user-id-here
BIZM_PROFILE_KEY=your-bizm-profile-key-here

# Optional: SMS fallback sender number registered in BizM
BIZM_SMS_SENDER=

# Optional: override BizM template IDs if production IDs differ from defaults
BIZM_TEMPLATE_RENTAL_CREATED=remind00
BIZM_TEMPLATE_D7=remind01
BIZM_TEMPLATE_D13=remind02
BIZM_TEMPLATE_D179=reset01
BIZM_LOST_REPORT_URL=

# Optional: set to false to disable the daily noon reminder scheduler on this server
BIZM_SCHEDULER_ENABLED=true

# Optional: delay rental-created Alimtalk after rental completion (milliseconds)
BIZM_RENTAL_CREATED_DELAY_MS=0

# Optional: BizM API timeout (milliseconds)
BIZM_TIMEOUT_MS=100000
